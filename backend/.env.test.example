# ==============================================================================
# Streamiify Backend Test Environment Template
# Safe, non-production test placeholders for local test execution and CI
# DO NOT place real production secrets or credentials in this file.
# ==============================================================================

NODE_ENV=test
PORT=8000
MONGO_URI=mongodb://localhost:27017/streamify_test

# JWT Authentication Secrets (Test placeholders)
ACCESS_TOKEN_SECRET=test_access_token_secret_min_32_characters_long
ACCESS_TOKEN_EXPIRE=1d
REFRESH_TOKEN_SECRET=test_refresh_token_secret_min_32_characters_long
REFRESH_TOKEN_EXPIRE=7d

# Cloudinary Media Storage (Mocked during tests)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-key
CLOUDINARY_API_SECRET=test-secret

# Redis Caching (Disabled during tests)
REDIS_URL=redis://localhost:6379
ENABLE_REDIS=false

# CORS & Frontend URLs
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Video Upload Limits
MAX_VIDEO_SIZE=1073741824

# Resend Email Delivery (Mocked/constructor dummy key)
RESEND_API_KEY=re_test_dummy_key_12345
EMAIL_FROM=Streamify <onboarding@resend.dev>
