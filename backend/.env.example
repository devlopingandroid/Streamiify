# ==============================================================================
# Streamiify Backend Environment Template
# Copy this file to .env (for local run) or .env.docker (for Docker Compose)
# DO NOT commit real secrets or credentials to GitHub.
# ==============================================================================

# Server Configuration
PORT=8000
NODE_ENV=development

# Database (MongoDB Atlas or local MongoDB instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/streamiify?retryWrites=true&w=majority

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_min_32_characters_long
ACCESS_TOKEN_EXPIRE=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_min_32_characters_long
REFRESH_TOKEN_EXPIRE=7d

# Cloudinary Media Storage (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Caching (For Docker Compose, use service name: redis://streamify-redis:6379)
REDIS_URL=redis://streamify-redis:6379
ENABLE_REDIS=true

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Frontend Base URL
FRONTEND_URL=http://localhost:3000

# Maximum Video Upload Size (in bytes: 104857600 = 100MB, 1073741824 = 1GB)
MAX_VIDEO_SIZE=1073741824

# Resend Email Delivery Service (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Streamify <onboarding@resend.dev>
